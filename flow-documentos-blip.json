{
  "version": "7.3",
  "screens": [
    {
      "id": "DOCUMENTOS",
      "title": "Documentos",
      "terminal": true,
      "success": true,
      "data": {
        "documentos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "28",
              "title": "HISTÓRICO ACADÊMICO"
            }
          ]
        },
        "texto": {
          "type": "string",
          "__example__": "Envie um documento por vez. PDF, JPG ou PNG, até 740 KB."
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Documentos da inscrição"
          },
          {
            "type": "TextBody",
            "text": "${data.texto}"
          },
          {
            "type": "Dropdown",
            "name": "documento",
            "label": "Documento",
            "data-source": "${data.documentos}",
            "required": true
          },
          {
            "type": "DocumentPicker",
            "name": "arquivo",
            "label": "Arquivo",
            "description": "PDF, JPG ou PNG de até 740 KB",
            "min-uploaded-documents": 1,
            "max-uploaded-documents": 1,
            "max-file-size-kb": 740,
            "allowed-mime-types": [
              "application/pdf",
              "image/jpeg",
              "image/png"
            ]
          },
          {
            "type": "Footer",
            "label": "Enviar documento",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "documento": "${form.documento}",
                "arquivo": "${form.arquivo}"
              }
            }
          }
        ]
      }
    }
  ]
}
