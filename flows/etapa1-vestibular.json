{
  "version": "7.3",
  "data_api_version": "3.0",
  "routing_model": {
    "INSC_INICIO": [
      "INSC_DADOS",
      "INSC_FIM"
    ],
    "INSC_DADOS": [
      "INSC_CURSO",
      "INSC_FIM"
    ],
    "INSC_CURSO": [
      "INSC_QUASE_LA",
      "INSC_FIM"
    ],
    "INSC_QUASE_LA": [
      "INSC_CONCLUIDA",
      "INSC_FIM"
    ],
    "INSC_CONCLUIDA": [
      "INSC_REDACAO",
      "INSC_FIM"
    ],
    "INSC_REDACAO": [
      "INSC_FIM"
    ],
    "INSC_FIM": []
  },
  "screens": [
    {
      "id": "INSC_INICIO",
      "title": "Inscrição",
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form_processo",
            "children": [
              {
                "type": "TextHeading",
                "text": "Inscrição"
              },
              {
                "type": "Dropdown",
                "name": "processo_seletivo_id",
                "label": "Escolha o processo seletivo",
                "required": true,
                "data-source": [
                  {
                    "id": "20383",
                    "title": "Vestibular Online 2027/1"
                  },
                  {
                    "id": "20385",
                    "title": "Transferência 2027/1"
                  },
                  {
                    "id": "20384",
                    "title": "Portador de Diploma 2027/1"
                  },
                  {
                    "id": "20386",
                    "title": "Nota do ENEM 2027/1"
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "Iniciar inscrição",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "acao": "e1_iniciar",
                    "processo_seletivo_id": "${form.processo_seletivo_id}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "INSC_DADOS",
      "title": "Dados básicos",
      "data": {
        "estado": {
          "type": "string",
          "__example__": ""
        },
        "erro": {
          "type": "string",
          "__example__": ""
        },
        "tem_erro": {
          "type": "boolean",
          "__example__": false
        },
        "data_maxima_nascimento": {
          "type": "string",
          "__example__": "2026-11-15"
        },
        "valor_nome": {
          "type": "string",
          "__example__": ""
        },
        "valor_possui_nome_social": {
          "type": "boolean",
          "__example__": false
        },
        "valor_nome_social": {
          "type": "string",
          "__example__": ""
        },
        "valor_email": {
          "type": "string",
          "__example__": ""
        },
        "valor_data_nascimento": {
          "type": "string",
          "__example__": ""
        },
        "valor_celular": {
          "type": "string",
          "__example__": ""
        },
        "valor_genero": {
          "type": "string",
          "__example__": ""
        },
        "valor_aceite_privacidade": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form_dados",
            "init-values": {
              "nome": "${data.valor_nome}",
              "possui_nome_social": "${data.valor_possui_nome_social}",
              "nome_social": "${data.valor_nome_social}",
              "email": "${data.valor_email}",
              "celular": "${data.valor_celular}",
              "genero": "${data.valor_genero}",
              "aceite_privacidade": "${data.valor_aceite_privacidade}"
            },
            "children": [
              {
                "type": "TextHeading",
                "text": "Dados básicos"
              },
              {
                "type": "TextBody",
                "text": "Olá! Para começar, preencha alguns dados básicos sobre você:"
              },
              {
                "type": "TextBody",
                "text": "${data.erro}",
                "visible": "${data.tem_erro}"
              },
              {
                "type": "TextInput",
                "name": "nome",
                "label": "Nome completo",
                "input-type": "text",
                "required": true
              },
              {
                "type": "OptIn",
                "name": "possui_nome_social",
                "label": "Possuo nome social",
                "required": false
              },
              {
                "type": "If",
                "condition": "${form.possui_nome_social} == true",
                "then": [
                  {
                    "type": "TextInput",
                    "name": "nome_social",
                    "label": "Nome social",
                    "input-type": "text",
                    "required": true
                  }
                ],
                "else": []
              },
              {
                "type": "TextInput",
                "name": "email",
                "label": "E-mail",
                "input-type": "email",
                "required": true
              },
              {
                "type": "CalendarPicker",
                "name": "data_nascimento",
                "label": "Data de nascimento",
                "mode": "single",
                "min-date": "1920-01-01",
                "max-date": "${data.data_maxima_nascimento}",
                "required": true
              },
              {
                "type": "TextInput",
                "name": "celular",
                "label": "Celular",
                "helper-text": "Para facilitar o nosso contato, informe o seu WhatsApp, de preferência.",
                "input-type": "phone",
                "required": true
              },
              {
                "type": "RadioButtonsGroup",
                "name": "genero",
                "label": "Gênero",
                "required": true,
                "data-source": [
                  {
                    "id": "M",
                    "title": "Masculino"
                  },
                  {
                    "id": "F",
                    "title": "Feminino"
                  }
                ]
              },
              {
                "type": "OptIn",
                "name": "aceite_privacidade",
                "label": "Aceito receber conteúdos e lembretes sobre o processo seletivo e concordo com a Política de Privacidade vigente.",
                "required": true,
                "on-click-action": {
                  "name": "open_url",
                  "url": "https://lp.unibalsas.edu.br/lgpd/"
                }
              },
              {
                "type": "Footer",
                "label": "Avançar",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "acao": "enviar_dados_basicos",
                    "estado": "${data.estado}",
                    "nome": "${form.nome}",
                    "possui_nome_social": "${form.possui_nome_social}",
                    "nome_social": "${form.nome_social}",
                    "email": "${form.email}",
                    "data_nascimento": "${form.data_nascimento}",
                    "celular": "${form.celular}",
                    "genero": "${form.genero}",
                    "aceite_privacidade": "${form.aceite_privacidade}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "INSC_CURSO",
      "title": "Curso de interesse",
      "data": {
        "estado": {
          "type": "string",
          "__example__": ""
        },
        "erro": {
          "type": "string",
          "__example__": ""
        },
        "tem_erro": {
          "type": "boolean",
          "__example__": false
        },
        "cursos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": []
        },
        "turnos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": []
        },
        "turno_visivel": {
          "type": "boolean",
          "__example__": false
        },
        "valor_curso_id": {
          "type": "string",
          "__example__": ""
        },
        "valor_turno_id": {
          "type": "string",
          "__example__": ""
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form_curso",
            "init-values": {
              "curso_id": "${data.valor_curso_id}",
              "turno_id": "${data.valor_turno_id}"
            },
            "children": [
              {
                "type": "TextHeading",
                "text": "Curso de interesse"
              },
              {
                "type": "TextBody",
                "text": "Conte-nos mais detalhes sobre o curso de seu interesse!"
              },
              {
                "type": "TextBody",
                "text": "${data.erro}",
                "visible": "${data.tem_erro}"
              },
              {
                "type": "Dropdown",
                "name": "curso_id",
                "label": "Curso",
                "data-source": "${data.cursos}",
                "required": true,
                "on-select-action": {
                  "name": "data_exchange",
                  "payload": {
                    "acao": "buscar_turnos",
                    "estado": "${data.estado}",
                    "curso_id": "${form.curso_id}"
                  }
                }
              },
              {
                "type": "If",
                "condition": "${data.turno_visivel} == true",
                "then": [
                  {
                    "type": "Dropdown",
                    "name": "turno_id",
                    "label": "Turno",
                    "data-source": "${data.turnos}",
                    "required": true
                  }
                ],
                "else": []
              },
              {
                "type": "Footer",
                "label": "Avançar",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "acao": "escolher_curso",
                    "estado": "${data.estado}",
                    "curso_id": "${form.curso_id}",
                    "turno_id": "${form.turno_id}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "INSC_QUASE_LA",
      "title": "Estamos quase lá",
      "data": {
        "estado": {
          "type": "string",
          "__example__": ""
        },
        "erro": {
          "type": "string",
          "__example__": ""
        },
        "tem_erro": {
          "type": "boolean",
          "__example__": false
        },
        "origens": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": []
        },
        "valor_cpf": {
          "type": "string",
          "__example__": ""
        },
        "valor_nacionalidade": {
          "type": "string",
          "__example__": "10"
        },
        "valor_concluiu_ensino_medio": {
          "type": "string",
          "__example__": ""
        },
        "valor_possui_deficiencia": {
          "type": "string",
          "__example__": ""
        },
        "valor_tipos_deficiencia": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "__example__": []
        },
        "valor_deficiencia_outra": {
          "type": "string",
          "__example__": ""
        },
        "valor_como_conheceu": {
          "type": "string",
          "__example__": ""
        },
        "valor_como_conheceu_outro": {
          "type": "string",
          "__example__": ""
        },
        "eh_nota_enem": {
          "type": "boolean",
          "__example__": false
        },
        "anos_enem": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              }
            }
          },
          "__example__": []
        },
        "valor_numero_inscricao_enem": {
          "type": "string",
          "__example__": ""
        },
        "valor_ano_enem": {
          "type": "string",
          "__example__": ""
        },
        "valor_nota_natureza_enem": {
          "type": "string",
          "__example__": ""
        },
        "valor_nota_humanas_enem": {
          "type": "string",
          "__example__": ""
        },
        "valor_nota_matematica_enem": {
          "type": "string",
          "__example__": ""
        },
        "valor_nota_linguagens_enem": {
          "type": "string",
          "__example__": ""
        },
        "valor_nota_redacao_enem": {
          "type": "string",
          "__example__": ""
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form_quase_la",
            "init-values": {
              "cpf": "${data.valor_cpf}",
              "nacionalidade": "${data.valor_nacionalidade}",
              "concluiu_ensino_medio": "${data.valor_concluiu_ensino_medio}",
              "possui_deficiencia": "${data.valor_possui_deficiencia}",
              "tipos_deficiencia": "${data.valor_tipos_deficiencia}",
              "deficiencia_outra": "${data.valor_deficiencia_outra}",
              "como_conheceu": "${data.valor_como_conheceu}",
              "como_conheceu_outro": "${data.valor_como_conheceu_outro}",
              "numero_inscricao_enem": "${data.valor_numero_inscricao_enem}",
              "ano_enem": "${data.valor_ano_enem}",
              "nota_natureza_enem": "${data.valor_nota_natureza_enem}",
              "nota_humanas_enem": "${data.valor_nota_humanas_enem}",
              "nota_matematica_enem": "${data.valor_nota_matematica_enem}",
              "nota_linguagens_enem": "${data.valor_nota_linguagens_enem}",
              "nota_redacao_enem": "${data.valor_nota_redacao_enem}"
            },
            "children": [
              {
                "type": "TextHeading",
                "text": "Estamos quase lá!"
              },
              {
                "type": "TextBody",
                "text": "Complete as suas informações para concluir a sua inscrição:"
              },
              {
                "type": "TextBody",
                "text": "${data.erro}",
                "visible": "${data.tem_erro}"
              },
              {
                "type": "TextInput",
                "name": "cpf",
                "label": "CPF",
                "helper-text": "Somente os 11 números",
                "input-type": "text",
                "required": true
              },
              {
                "type": "Dropdown",
                "name": "nacionalidade",
                "label": "Nacionalidade",
                "required": true,
                "data-source": [
                  {
                    "id": "10",
                    "title": "Brasileira"
                  },
                  {
                    "id": "20",
                    "title": "Naturalizado Brasileiro"
                  },
                  {
                    "id": "50",
                    "title": "Outros"
                  }
                ]
              },
              {
                "type": "RadioButtonsGroup",
                "name": "concluiu_ensino_medio",
                "label": "Você já concluiu o ensino médio?",
                "required": true,
                "data-source": [
                  {
                    "id": "Sim",
                    "title": "Sim"
                  },
                  {
                    "id": "Não",
                    "title": "Não"
                  }
                ]
              },
              {
                "type": "RadioButtonsGroup",
                "name": "possui_deficiencia",
                "label": "Possui alguma deficiência?",
                "required": true,
                "data-source": [
                  {
                    "id": "T",
                    "title": "Sim"
                  },
                  {
                    "id": "F",
                    "title": "Não"
                  }
                ]
              },
              {
                "type": "If",
                "condition": "${form.possui_deficiencia} == 'T'",
                "then": [
                  {
                    "type": "CheckboxGroup",
                    "name": "tipos_deficiencia",
                    "label": "Necessidades especiais",
                    "required": true,
                    "data-source": [
                      {
                        "id": "auditiva",
                        "title": "Auditiva"
                      },
                      {
                        "id": "fala",
                        "title": "Fala"
                      },
                      {
                        "id": "fisica",
                        "title": "Física"
                      },
                      {
                        "id": "intelectual",
                        "title": "Intelectual"
                      },
                      {
                        "id": "visual",
                        "title": "Visual"
                      },
                      {
                        "id": "mental",
                        "title": "Mental"
                      },
                      {
                        "id": "outras",
                        "title": "Outras"
                      }
                    ]
                  },
                  {
                    "type": "TextInput",
                    "name": "deficiencia_outra",
                    "label": "Se marcou Outras, especifique:",
                    "input-type": "text",
                    "required": false
                  }
                ],
                "else": []
              },
              {
                "type": "Dropdown",
                "name": "como_conheceu",
                "label": "Como ficou sabendo do processo?",
                "required": true,
                "data-source": "${data.origens}"
              },
              {
                "type": "If",
                "condition": "${form.como_conheceu} == '10'",
                "then": [
                  {
                    "type": "TextInput",
                    "name": "como_conheceu_outro",
                    "label": "Especifique o canal:",
                    "input-type": "text",
                    "required": true
                  }
                ],
                "else": []
              },
              {
                "type": "If",
                "condition": "${data.eh_nota_enem} == true",
                "then": [
                  {
                    "type": "TextSubheading",
                    "text": "Notas do ENEM"
                  },
                  {
                    "type": "TextBody",
                    "text": "Informe os dados oficiais do seu exame (notas entre 0 e 1000):"
                  },
                  {
                    "type": "TextInput",
                    "name": "numero_inscricao_enem",
                    "label": "Nº de inscrição do ENEM",
                    "helper-text": "12 a 15 números",
                    "input-type": "text",
                    "required": true
                  },
                  {
                    "type": "Dropdown",
                    "name": "ano_enem",
                    "label": "Ano do exame",
                    "data-source": "${data.anos_enem}",
                    "required": true
                  },
                  {
                    "type": "TextInput",
                    "name": "nota_natureza_enem",
                    "label": "Ciências da Natureza",
                    "input-type": "text",
                    "required": true
                  },
                  {
                    "type": "TextInput",
                    "name": "nota_humanas_enem",
                    "label": "Ciências Humanas",
                    "input-type": "text",
                    "required": true
                  },
                  {
                    "type": "TextInput",
                    "name": "nota_matematica_enem",
                    "label": "Matemática",
                    "input-type": "text",
                    "required": true
                  },
                  {
                    "type": "TextInput",
                    "name": "nota_linguagens_enem",
                    "label": "Linguagens e Códigos",
                    "input-type": "text",
                    "required": true
                  },
                  {
                    "type": "TextInput",
                    "name": "nota_redacao_enem",
                    "label": "Redação",
                    "input-type": "text",
                    "required": true
                  }
                ],
                "else": []
              },
              {
                "type": "Footer",
                "label": "Concluir",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "acao": "enviar_informacoes_complementares",
                    "estado": "${data.estado}",
                    "cpf": "${form.cpf}",
                    "nacionalidade": "${form.nacionalidade}",
                    "concluiu_ensino_medio": "${form.concluiu_ensino_medio}",
                    "possui_deficiencia": "${form.possui_deficiencia}",
                    "tipos_deficiencia": "${form.tipos_deficiencia}",
                    "deficiencia_outra": "${form.deficiencia_outra}",
                    "como_conheceu": "${form.como_conheceu}",
                    "como_conheceu_outro": "${form.como_conheceu_outro}",
                    "numero_inscricao_enem": "${form.numero_inscricao_enem}",
                    "ano_enem": "${form.ano_enem}",
                    "nota_natureza_enem": "${form.nota_natureza_enem}",
                    "nota_humanas_enem": "${form.nota_humanas_enem}",
                    "nota_matematica_enem": "${form.nota_matematica_enem}",
                    "nota_linguagens_enem": "${form.nota_linguagens_enem}",
                    "nota_redacao_enem": "${form.nota_redacao_enem}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "INSC_CONCLUIDA",
      "title": "Inscrição",
      "data": {
        "estado": {
          "type": "string",
          "__example__": ""
        },
        "erro": {
          "type": "string",
          "__example__": ""
        },
        "tem_erro": {
          "type": "boolean",
          "__example__": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Obrigado pelo seu cadastro! ✅"
          },
          {
            "type": "TextBody",
            "text": "${data.erro}",
            "visible": "${data.tem_erro}"
          },
          {
            "type": "TextSubheading",
            "text": "Prova online: Prova disponível"
          },
          {
            "type": "TextBody",
            "text": "Você tem até 120 minutos para elaborar um texto dissertativo-argumentativo."
          },
          {
            "type": "EmbeddedLink",
            "text": "Sair (realizar a prova de redação em outro momento)",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "acao": "sair",
                "estado": "${data.estado}"
              }
            }
          },
          {
            "type": "Footer",
            "label": "Realizar prova",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "acao": "iniciar_redacao",
                "estado": "${data.estado}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "INSC_REDACAO",
      "title": "Redação",
      "data": {
        "estado": {
          "type": "string",
          "__example__": ""
        },
        "erro": {
          "type": "string",
          "__example__": ""
        },
        "tem_erro": {
          "type": "boolean",
          "__example__": false
        },
        "tema_redacao": {
          "type": "string",
          "__example__": "Tema da redação"
        },
        "valor_texto_redacao": {
          "type": "string",
          "__example__": ""
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form_redacao",
            "init-values": {
              "texto_redacao": "${data.valor_texto_redacao}"
            },
            "children": [
              {
                "type": "TextHeading",
                "text": "Prova de Redação"
              },
              {
                "type": "TextCaption",
                "text": "Você tem até 120 minutos para elaborar um texto dissertativo-argumentativo sobre o tema abaixo."
              },
              {
                "type": "TextBody",
                "text": "${data.erro}",
                "visible": "${data.tem_erro}"
              },
              {
                "type": "TextBody",
                "text": "${data.tema_redacao}"
              },
              {
                "type": "TextArea",
                "name": "texto_redacao",
                "label": "Digite aqui seu texto dissertativo",
                "required": true,
                "max-length": 3000
              },
              {
                "type": "Footer",
                "label": "Enviar redação",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "acao": "enviar_redacao",
                    "estado": "${data.estado}",
                    "texto_redacao": "${form.texto_redacao}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "INSC_FIM",
      "title": "Prova online",
      "terminal": true,
      "success": true,
      "data": {
        "titulo": {
          "type": "string",
          "__example__": "Redação enviada ✅"
        },
        "mensagem": {
          "type": "string",
          "__example__": ""
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.titulo}"
          },
          {
            "type": "TextBody",
            "text": "${data.mensagem}"
          },
          {
            "type": "Footer",
            "label": "Concluir",
            "on-click-action": {
              "name": "complete",
              "payload": {}
            }
          }
        ]
      }
    }
  ]
}
